{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@xiaochuan/cli-rs",
  "private": true,
  "type": "module",
  "scripts": {
    "cargo": "bun run script/opentui-native.ts --quiet && cargo",
    "opentui:native": "bun run script/opentui-native.ts",
    "generate": "bun run script/generate.ts",
    "fixtures": "bun run parity/fixtures.ts",
    "check:drift": "bun run script/drift.ts",
    "check:deny": "cargo deny --workspace --frozen check --hide-inclusion-graph licenses bans sources",
    "check:luau-types": "bun run script/check-luau-types.ts",
    "check:advisories": "cargo deny --workspace --locked check --hide-inclusion-graph advisories",
    "parity:acp": "bun run parity/acp/run.ts",
    "parity:cli": "bun run parity/cli/run.ts",
    "parity:pty": "bun run parity/pty/run.ts",
    "parity:sim": "bun run parity/sim/run.ts",
    "live": "sh script/live.sh",
    "parity:machines": "cd parity && bun test ./machines/plugins.test.tsx",
    "parity:machines:deep": "cd parity && PARITY_DEEP=1 bun test ./machines/plugins.test.tsx",
    "parity:typecheck": "tsc --noEmit",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@xiaochuan/httpapi-codegen": "workspace:*",
    "@xiaochuan/plugin": "workspace:*",
    "@xiaochuan/protocol": "workspace:*",
    "@xiaochuan/tui": "workspace:*",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "solid-js": "catalog:"
  }
}
