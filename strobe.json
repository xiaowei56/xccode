{
  "build": { "command": "bun run build", "cwd": "packages/app", "output": "packages/app/dist" },
  "serve": { "command": "bun e2e/utils/serve.ts --host 127.0.0.1 --port {port}", "cwd": "packages/app" },
  "apps": {
    "xccode": {
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.xccode.desktop/Xccode.exe",
        "macos": "/Applications/Xccode.app/Contents/MacOS/Xccode"
      },
      "unset": ["XCCODE_*", "OTEL_*", "SENTRY_*"],
      "env": {
        "XCCODE_DB": "{home}/.local/share/xccode/xccode.db",
        "XCCODE_CONFIG_DIR": "{home}/.config/xccode",
        "HTTP_PROXY": "http://127.0.0.1:9",
        "HTTPS_PROXY": "http://127.0.0.1:9",
        "NO_PROXY": "localhost,127.0.0.1,::1"
      },
      "dirs": [".local/share/xccode"],
      "files": {
        ".config/xccode/service.json": { "port": "{port}" },
        "AppData/Local/@xccodedesktop-updater": "a file, not a folder: the updater cannot stage a download while strobe measures"
      },
      "guard": [{ "file": "~/.local/state/xccode/service.json", "pid": "pid", "url": "url" }],
      "protocols": ["xccode"]
    },
    "xccode-beta": {
      "extends": "xccode",
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.xccode.desktop.beta/Xccode Beta.exe",
        "macos": "/Applications/Xccode Beta.app/Contents/MacOS/Xccode Beta"
      }
    }
  }
}
